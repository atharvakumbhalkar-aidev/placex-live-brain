# Live Brain Real-Time Voice & Avatar Interview Engine Configuration

# Required Service API Keys
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Simli Avatar Service (Optional: set ENABLE_AVATAR=false for voice-only mode)
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=your_simli_face_id_here
ENABLE_AVATAR=true

# Optional WebRTC Room Transport
DAILY_API_KEY=your_daily_api_key_here
DAILY_SAMPLE_ROOM_URL=your_daily_sample_room_url_here

# Runtime & Model Settings
GEMINI_MODEL=your_gemini_model_id_here
LLM_PROVIDER=gemini
SESSION_ID=live-session-demo
QUESTION_BANK_PATH=tests/fixtures/sample_question_bank.json
ENABLE_LATENCY_TIMER=true
